<header>
  <h2>New Template Product</h2>
  <p>Fill in the form below to create a new template product.</p>
</header>

<section>
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}"}
    flash={@flash}
    edit={false}
    templates={@templates}
    substances={@substances}
    filling_methods={@filling_methods}
    dose_units={@dose_units}
    formularies={@formularies}
    template_id={@template_id}
  />
</section>
<button type="button" aria-label="Close dialog" onclick="this.closest('dialog').close()">
  <.icon_x_mark />
</button>
