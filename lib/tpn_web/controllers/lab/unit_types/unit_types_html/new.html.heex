<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Unit Types", to: "#{get_url()}"},
  %{label: "New Unit Type"}
]} />
<div class="mx-auto max-w-3xl">
  <.form_header>
    New Unit Type
  </.form_header>
</div>
<div class="mx-auto max-w-3xl">
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}"}
    flash={@flash}
    edit={false}
    is_admin={@is_admin}
    current_user={@current_user}
  />
</div>
