<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Ingredients", to: "#{get_url()}"},
  %{label: "Edit Ingredient"}
]} />
<div class="mx-auto max-w-3xl">
  <.form_header>
    Update Ingredient
  </.form_header>
</div>
<div id="form_container" class="mx-auto max-w-3xl">
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}/#{@record.id}"}
    flash={@flash}
    edit={true}
    is_admin={@is_admin}
    unit_types={@unit_types}
  />
</div>
