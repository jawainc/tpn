<%= if(!Enum.empty?(@records)) do %>
  <.table id="unit_types" rows={@records} url={get_url()} meta={@meta}>
    <:col :let={record} label="Name" field={:name}><%= record.name %></:col>
    <:col :let={record} label="Code" field={:code}><%= record.code %></:col>
    <:col :let={record} label="Cost" field={:cost_per_container}>
      <%= record.cost_per_container %>
    </:col>
    <:col :let={record} label="Size" field={:container_size}><%= record.container_size %></:col>
    <:col :let={record} label="Print" field={:print_on_label}>
      <.empty_badge status={record.print_on_label} />
    </:col>

    <:col :let={record} :if={@is_admin} label="Added By" field={:user_name}>
      <%= record.user_name %>
    </:col>

    <:action :let={record} :if={@is_admin || @can.update}>
      <button
        hx-get={"#{get_url()}/#{record.id}/edit"}
        hx-target="#main-contents"
        hx-indicator=".main-contents-loader"
        type="button"
        class="btn btn-info btn-xs"
      >
        Edit
      </button>
    </:action>

    <:action :let={record} :if={@is_admin || @can.delete}>
      <.form
        for={%{}}
        method="delete"
        action={"#{get_url()}/#{record.id}"}
        hx-delete={"#{get_url()}/#{record.id}"}
        hx-confirm="Are you sure to delete?"
      >
        <button class="btn btn-error btn-xs">
          Delete
        </button>
      </.form>
    </:action>
  </.table>

  <%= if @meta.has_previous_page or @meta.has_next_page do %>
    <.pagination meta={@meta} url={get_url()} />
  <% end %>
<% else %>
  <.no_records />
<% end %>
