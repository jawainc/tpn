<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  hx-post={@action}
  hx-target="#main-contents"
  hx-disabled-elt="#form-button"
  hx-on::config-request="formConfigRequest(event)"
  autocomplete="off"
>
  <.flash_group flash={@flash} />

  <section class="w-full rounded-lg border overflow-hidden scroll-mt-16">
    <header class="border-b px-4 py-3 font-semibold bg-card text-card-foreground">
      Product Data
    </header>
    <div class="p-4 grid md:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4 items-start">
      <.input field={f[:drug_id]} type="text" label="Drug ID" />
      <.input field={f[:name]} type="text" label="Name" required />
      <.input field={f[:code]} type="text" label="Code" required />
      <.input field={f[:label_friendly_name]} type="text" label="Label Friendly Name" required />
      <.input
        field={f[:cost_per_container]}
        type="input-inside-label"
        label="Cost per Container"
        label_inside_left={get_currency_symbol(@currency)}
        label_inside_right={get_currency_code(@currency)}
        placeholder="0.0000"
        step=".0001"
        input_type="number"
      />
      <.input field={f[:container_size]} type="number" label="Container Size" step=".0001" />
      <.input
        field={f[:osmolarity]}
        type="number"
        label="Osmolarity"
        step=".0001"
        placeholder="0.0000"
        required
      />
      <.input
        field={f[:class_id]}
        type="select"
        label="Class"
        options={@classes}
        prompt="Select..."
        required
      />
      <.input
        field={f[:solution_type_id]}
        type="select"
        label="Solution Type"
        options={@solution_types}
        prompt="Select..."
        required
      />
      <.input
        field={f[:uom_unit_id]}
        type="select"
        label="UOM Unit"
        options={@uom_units}
        prompt="Select..."
        required
      />
      <.input
        field={f[:concentration]}
        field_2={f[:concentration_unit_id]}
        type="input-with-select"
        label="Concentration"
        options={@concentration_units}
        options_label="Unit..."
        placeholder="0.0000"
        input_type="number"
        step=".0001"
        required
      />
      <.input
        field={f[:calories]}
        field_2={f[:calories_unit_id]}
        type="input-with-select"
        label="Calories"
        options={@calories_units}
        options_label="Unit..."
        placeholder="0.0000"
        input_type="number"
        step=".0001"
        required
      />
    </div>
    <div class="p-4 grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <.input type="checkbox" label="Is Enteral" field={f[:is_enteral]} />
      <.input type="checkbox" label="Print on Label" field={f[:print_on_label]} />
      <.input type="checkbox" label="Include in Overfill" field={f[:include_in_overfill]} />
      <.input type="checkbox" label="Universal Fluid" field={f[:universal_fluid]} />
      <.input type="checkbox" label="Active" field={f[:active]} />
    </div>
  </section>

  <section class="w-full rounded-lg border scroll-mt-16">
    <header class="border-b px-4 py-3 font-semibold bg-card text-card-foreground">
      Patient Types
    </header>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 p-4">
      <label :for={{name, id} <- @patient_types} class="label gap-3">
        <input
          type="checkbox"
          checked={is_selected?(@edit, id, @selected_patient_types)}
          class="input patient-type-checks"
          id={"checkbox-#{id}"}
        />
        <span class="label-text ml-2">{name}</span>
      </label>
    </div>

    <input
      type="hidden"
      name="formulary[patient_types]"
      id="types"
      value={types_value(@selected_patient_types)}
    />
  </section>

  <.ingredients
    ingredients={@ingredients}
    selected_ingredients={@selected_ingredients}
    ingredients_units={@ingredients_units}
  />

  <div class="flex justify-end items-center gap-4">
    <button id="form-button" type="submit" class="btn">
      <%= if(@edit) do %>
        Update formulary
      <% else %>
        Create new formulary
      <% end %>
      <.htmx_indicator id="form-button-indicator" />
    </button>
  </div>
</.simple_form>

<script>
  // on checkbox changes, use checkbox id to update the hidden input value
  document.querySelectorAll('.patient-type-checks').forEach((checkbox) => {
      checkbox.addEventListener('change', (e) => {
          const types = document.querySelector('#types');
          const checked = Array.from(document.querySelectorAll('.patient-type-checks:checked')).map((el) => el.id.split('-')[1]);
          types.value = checked.join(',');
      });
  });
</script>
