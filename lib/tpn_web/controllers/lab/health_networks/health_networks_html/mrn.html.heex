<%= if is_nil(@mrn) do %>
  <span>M.R.N<span class="text-error">*</span></span>
  <input
    class="input input-bordered w-full h-10"
    type="text"
    value=""
    name="admission[mrn]"
    id="admission_mrn"
    required
  />
<% else %>
  <input type="hidden" name="admission[has_mrn]" value={@mrn.mrn} />
  <div class="flex flex-col space-y-1">
    <span>M.R.N</span>
    <span class="font-semibold">{@mrn.mrn}</span>
  </div>
<% end %>
