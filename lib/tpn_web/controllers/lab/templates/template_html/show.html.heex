<div class="mx-auto max-w-7xl">
  <.header>
    Template
  </.header>

  <div class="flex items-center justify-between">
    <div class="breadcrumbs text-sm">
      <ul>
        <li>
          <a
            hx-get={"#{get_url()}"}
            hx-target="#main-contents"
            hx-indicator=".main-contents-loader"
          >
            Templates
          </a>
        </li>
        <li>Template Details</li>
      </ul>
    </div>
  </div>

  <.template_details template={@record} />
  <.template_products
    :if={
      UserAccessLevel.has_menu_access_level?(@user_access_level, @is_admin, [
        "TemplateProducts"
      ])
    }
    template_id={@record.id}
  />
  <.form_modal classes="max-w-3xl" />
</div>
