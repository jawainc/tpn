<%= if(!Enum.empty?(@records)) do %>
  <.table id="wards" rows={@records} url={get_url()} meta={@meta}>
    <:col :let={record} label="Name" field={:name}>{record.name}</:col>
    <:col :let={record} label="Patient Type" field={:patient_type_id}>
      {record.patient_type_name}
    </:col>
    <:col :let={record} label="Fluids" field={:fluids}>{record.fluids}</:col>
    <:col :let={record} label="Active" field={:active}>
      <.empty_badge status={record.active} />
    </:col>

    <:col :let={record} :if={@is_admin} label="Added By" field={:user_name}>
      {record.user_name}
    </:col>

    <:action :let={record}>
      <.view_button hx_get={"#{get_url()}/#{record.id}"}>
        View details
      </.view_button>
    </:action>

    <:action :let={record} :if={@is_admin || @can.update || @can.delete}>
      <.table_actions_edit_delete
        record={record}
        url={get_url()}
        is_admin={@is_admin}
        can_update={@can.update}
        can_delete={@can.delete}
      />
    </:action>
  </.table>

  <%= if @meta.has_previous_page or @meta.has_next_page do %>
    <.pagination meta={@meta} url={get_url()} />
  <% end %>
<% else %>
  <.no_records />
<% end %>
