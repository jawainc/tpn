<div id="form_container">
  <.header>
    New Unit
  </.header>
  
  <.data_form 
    changeset={@changeset} 
    action={"#{get_url()}"} 
    flash={@flash} 
    edit={false} 
    is_admin={@is_admin}
    current_user={@current_user}
    types={@types}
    selected_types={@selected_types}
    />
</div>

  