<%= if(!Enum.empty?(@records)) do %>
  <.table id="roles" rows={@records} url={get_url()} meta={@meta}>
    <:col :let={record} label="Name" field={:name}>{record.name}</:col>
    <:col :let={record} label="Admin" field={:is_admin}>
      <.empty_badge status={record.is_admin} />
    </:col>
    <:col :let={record} label="Verifier" field={:is_verifier}>
      <.empty_badge status={record.is_verifier} />
    </:col>

    <:action :let={record}>
      <div role="group" class="button-group">
        <button
          hx-get={"#{get_url()}/#{record.id}/rights"}
          hx-target="#main-contents"
          hx-indicator="#main-contents-indicator"
          type="button"
          class="btn-outline"
        >
          Permissions
        </button>
        <.table_actions_edit_delete
          :if={@is_admin || @can.update || @can.delete}
          record={record}
          url={get_url()}
          is_admin={@is_admin}
          can_update={@can.update}
          can_delete={@can.delete}
          edit_popup={false}
        />
      </div>
    </:action>
  </.table>

  <%= if @meta.has_previous_page or @meta.has_next_page do %>
    <.pagination meta={@meta} url={get_url()} />
  <% end %>
<% else %>
  <.no_records />
<% end %>
