<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  hx-post={@action}
  hx-target="#form_container"
  hx-disabled-elt="#form-button"
  hx-on::config-request="formConfigRequest(event)"
  autocomplete="off"
>
  <.flash_group flash={@flash} />

  <div class="grid grid-cols-2 gap-4">
    <.input
      field={f[:first_name]}
      type="text"
      label="First Name"
      required
      autocomplete="new-name"
    />
    <.input field={f[:last_name]} type="text" label="last Name" required autocomplete="new-name" />
    <.input field={f[:email]} type="email" label="Email" required autocomplete="new-email" />
    <.input field={f[:contact_no]} type="text" label="Conatct No" />
    <.input
      field={f[:role_id]}
      type="select"
      label="Role"
      prompt="Select..."
      options={@roles}
      required
    />
    <div></div>
    <.input field={f[:active]} type="checkbox" label="Active" />

    <%= if (!@edit) do %>
      <div class="divider col-span-2 ">Password</div>
      <.input
        field={f[:password]}
        type="password"
        label="Password"
        required
        autocomplete="new-password"
      />
      <.input field={f[:password_confirmation]} type="password" label="Confirm Password" required />
    <% end %>

    <div class="divider col-span-2 ">Networks</div>
    <.input
      hx-get="/health_networks"
      hx-target="#user_facility_id"
      hx-on:htmx-after-on-load="selectRemoveOptions('user_campus_id')"
      hx-disinherit="*"
      field={f[:local_health_network_id]}
      type="select"
      label="Local Health Network"
      prompt="Select..."
      options={@lhns}
    />

    <.input
      hx-get="/health_networks"
      hx-target="#user_campus_id"
      field={f[:facility_id]}
      type="select"
      label="Facility"
      prompt="Select..."
      options={@facilities}
    />

    <.input
      field={f[:campus_id]}
      type="select"
      label="Campus"
      prompt="Select..."
      options={@campuses}
    />
  </div>

  <:actions>
    <button id="form-button" type="submit" class="w-full btn btn-primary flex space-x-3">
      <%= if (!@edit) do %>
        Create
      <% else %>
        Update
      <% end %>
      <span class="loading loading-spinner loading-md htmx-indicator"></span>
    </button>
  </:actions>
</.simple_form>
