<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Users", to: "#{get_url()}"},
  %{label: "#{@user.first_name} #{@user.last_name}", to: "#{get_url()}/#{@user.id}/edit"},
  %{label: "Change Password"}
]} />
<div class="mx-auto max-w-3xl">
  <.form_header>
    Change Password
    <:subtitle>
      Change password for {@user.first_name} {@user.last_name}
    </:subtitle>
    <:actions>
      <button
        class="btn-sm-outline"
        hx-get={~p"/users/#{@user.id}/edit"}
        hx-target="#main-contents"
        hx-indicator="#main-contents-indicator"
      >
        Update User
      </button>
    </:actions>
  </.form_header>
</div>

<div id="form_container" class="mx-auto max-w-3xl">
  <.simple_form
    :let={f}
    for={@changeset}
    action={~p"/users/#{@user.id}/change_password"}
    hx-post={~p"/users/#{@user.id}/change_password"}
    hx-target="#main-contents"
    hx-disabled-elt="#form-button"
    hx-on::config-request="formConfigRequest(event)"
    autocomplete="off"
  >
    <.flash_group flash={@flash} />
    <.input
      field={f[:password]}
      type="password"
      label="Password"
      required
      autocomplete="new-password"
    />
    <.input field={f[:password_confirmation]} type="password" label="Confirm Password" required />
    <:actions>
      <button id="form-button" type="submit" class="btn">
        Update Password <.btn_htmx_indicator />
      </button>
    </:actions>
  </.simple_form>
</div>
