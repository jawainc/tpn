<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Facilities", to: "#{get_url()}"},
  %{label: "Update Facility"}
]} />
<div class="mx-auto max-w-3xl">
  <.form_header>
    Update Facility
  </.form_header>
</div>
<div class="mx-auto max-w-3xl">
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}/#{@record.id}"}
    flash={@flash}
    lhns={@lhns}
  />
</div>
