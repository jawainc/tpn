<div class="mx-auto max-w-7xl">
  <.header>
    Campuses
    <:actions>
      <button
        hx-get={"#{get_url()}/new"}
        hx-target="#table_modal_contents"
        hx-on:click="table_modal.showModal()"
        type="button"
        class="btn btn-sm btn-primary"
      >
        Create New
      </button>
    </:actions>
  </.header>
</div>
 <.search url={"#{get_url()}?table=1"} />
<div class="mx-auto max-w-7xl mt-10 ">
  <.htmx_indicator id="data-table-indicator" />
  <div
    id="data-table"
    class="hide-on-htmx-request"
    hx-get={"#{get_url()}?table=1"}
    hx-trigger="reloadDataTable from:body"
    hx-indicator="#data-table-indicator"
  >
    <.data_table records={@records} meta={@meta} />
  </div>
  
  <dialog id="table_modal" class="modal">
    <div class="modal-box">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      
      <div>
        <.htmx_indicator id="table_modal_indicator" />
        <div id="table_modal_contents" class="hide-on-htmx-request"></div>
      </div>
    </div>
  </dialog>
</div>
