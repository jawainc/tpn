<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Campuses", to: "#{get_url()}"},
  %{label: "Update Campus"}
]} />

<div class="mx-auto max-w-3xl">
  <.form_header>
    Update Campus
  </.form_header>
</div>
<div class="mx-auto max-w-3xl">
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}/#{@record.id}"}
    flash={@flash}
    facilities={@facilities}
  />
</div>
