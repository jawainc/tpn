<div id="form_container">
  <.header>
    New Room
  </.header>
  
  <.data_form 
    changeset={@changeset} 
    action={"#{get_url()}"} 
    flash={@flash} 
    edit={false} 
    is_admin={@is_admin} 
    wards={@wards}
    lhns={@lhns}
    facilities={@facilities}
    campuses={@campuses} 
    current_user={@current_user}
    />
</div>

  