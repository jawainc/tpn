<.bread_crumb items={[
  %{label: "Home", to: "/dash"},
  %{label: "Rooms", to: "#{get_url()}"},
  %{label: "New Room"}
]} />
<div class="mx-auto max-w-3xl">
  <.form_header>
    New Room
  </.form_header>
</div>
<div id="form_container" class="mx-auto max-w-3xl">
  <.data_form
    changeset={@changeset}
    action={"#{get_url()}"}
    flash={@flash}
    edit={false}
    is_admin={@is_admin}
    wards={@wards}
    lhns={@lhns}
    facilities={@facilities}
    campuses={@campuses}
    current_user={@current_user}
  />
</div>
