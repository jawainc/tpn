<div class="mx-auto max-w-7xl">
  <.header>
    Patients Dashboard
    <:actions>
      <button
        hx-get={"#{get_url()}/new"}
        hx-target="#main-contents"
        hx-indicator=".main-contents-loader"
        type="button"
        class="btn btn-sm btn-primary"
      >
        Create New
      </button>
    </:actions>
  </.header>
</div>

<div class="mx-auto max-w-7xl mt-10">
  <div
    x-data="{
  open_filter: false,
  filters: ['By Name', 'By TPN I.D', 'By I.D', 'By Email', 'By Contact'],
  selected: 'By Name'
  }"
    class="relative mt-10 w-96"
  >
    <input name="by_filter" x-model="selected" type="hidden" />
    <label class="input input-bordered input-sm flex items-center gap-2 w-fit pr-0 overflow-hidden">
      <.icon name="hero-magnifying-glass" class="w-4 h-4 opacity-70" />
      <input
        hx-trigger="keyup delay:500ms changed"
        hx-indicator="#search_indicator"
        type="text"
        name="filter"
        class="h-8 input input-sm border-none focus:ring-0"
        autocomplete="off"
        placeholder="Search..."
      />
      <span id="search_indicator" class="loading loading-spinner loading-xs htmx-indicator">
      </span>
      <div
        @click="open_filter = !open_filter"
        class="w-28 h-full bg-neutral text-base-content flex items-center justify-between px-2 cursor-pointer"
      >
        <span x-text="selected"></span>
        <.icon name="hero-chevron-down" class="w-3 h-3 opacity-70" />
      </div>
    </label>
    <div
      x-cloak
      x-show="open_filter"
      @click.outside="open_filter=false"
      class="absolute top-10 -right-3 rounded bg-neutral shadow-md z-20 w-32"
    >
      <template x-for="(filter, index) in filters">
        <div
          @click="selected=filter; open_filter=false"
          class="hover:bg-base-200 cursor-pointer p-2 text-sm flex items-center justify-between"
        >
          <span x-text="filter"></span>
          <div x-show="filter === selected">
            <.icon name="hero-check" class="w-3 h-3 opacity-70" />
          </div>
        </div>
      </template>
    </div>
  </div>

  <div>
    <.htmx_indicator id="data-table-indicator" />
    <div
      id="data-table"
      class="hide-on-htmx-request mt-10"
      hx-get={"#{get_url()}?table=1"}
      hx-trigger="reloadDataTable from:body"
      hx-indicator="#data-table-indicator"
    >
      <.data_table
        records={@records}
        meta={@meta}
        url={get_url()}
        is_admin={@is_admin}
        can={@can}
        current_user={@current_user}
      />
    </div>
  </div>
</div>
