<%= if is_nil(@template) do %>
  <div class="text-center">Select a template to view products</div>
<% else %>
  <script>
    window.templateData = {
      products: <%= raw @products %>,
      preMixed: <%= Jason.encode!(@template.pre_mixed_standard) %>,
      additionalSubstances: <%= Jason.encode!(@template.additional_substances_allowed) %>,
      classes: <%= raw @classes %>,
      fillingMethods: <%= raw @filling_methods %>,
      formularies: <%= raw @formularies %>,
      currency: <%= raw @currency %>
    };
  </script>
  <div
    x-data="orderTemplateProducts()"
    x-init="
      productsData = window.templateData.products;
      preMixedStandard = window.templateData.preMixed;
      additionalSubstancesAllowed = window.templateData.additionalSubstances;
      classes = window.templateData.classes;
      fillingMethods = window.templateData.fillingMethods;
      formularies = window.templateData.formularies;
      currency = window.templateData.currency;
      initialized();
      // Trigger initial calculations
      setTimeout(() => calculateAllValues(), 100);
    "
  >
    <!-- Osmolarity Alert Banner -->
    <div class="p-4">
      <.osmolarity_alert />
    </div>
    
<!-- Summary Cards Section -->
    <div class="p-4">
      <h3 class="text-lg font-semibold mb-4">Order Calculations Summary</h3>
      <.summary_cards />
    </div>

    <div class="grid grid-cols-6 gap-4 my-6 px-4">
      <label class="form-control w-full max-w-xs grid gap-3" for="template_fluids">
        <div class="label">
          <span class="label-text">
            Total Fluids (<i><%= @template.fluid_unit %></i>) <span class="text-error">*</span>
          </span>
        </div>
        <input
          name="template_fluids"
          id="template_fluids"
          type="number"
          step=".0001"
          class="input input-sm input-bordered"
          value={format_decimal(@template.fluids)}
          readonly={@template.pre_mixed_standard}
          x-on:change="onFormChange()"
        />
        <input
          type="hidden"
          id="bag_over_fill_volume"
          value={format_decimal(@template.bag_over_fill_volume)}
        />
      </label>
      <%= if @template.pre_mixed_standard do %>
        <label class="form-control w-full max-w-xs grid gap-3" for="template_tpn_dose">
          <div class="label">
            <span class="label-text">TPN Dose (<i>ml</i>)</span>
          </div>
          <input
            name="template_tpn_dose"
            type="number"
            step=".0001"
            class="input input-sm input-bordered"
            value="0.0"
            x-on:change="onFormChange()"
          />
        </label>
      <% end %>
      <%= if @template.pre_mixed_standard do %>
        <label class="form-control w-full max-w-xs grid gap-3" for="template_lipid_dose">
          <div class="label">
            <span class="label-text">Lipid Dose (<i>ml</i>)</span>
          </div>
          <input
            name="template_lipid_dose"
            type="number"
            step=".0001"
            class="input input-sm input-bordered"
            value="0.0"
            x-on:change="onFormChange()"
          />
        </label>
      <% end %>
      <%= if @template.pre_mixed_standard do %>
        <label class="form-control w-full max-w-xs grid gap-3" for="template_tpn_rate">
          <div class="label">
            <span class="label-text">TPN Rate</span>
          </div>
          <input
            name="template_tpn_rate"
            type="number"
            step=".0001"
            class="input input-sm input-read-only"
            value="0.0"
            readonly
            x-bind:value="calculations.infusion.tpnRate.toFixed(2)"
          />
        </label>
      <% end %>
      <%= if @template.pre_mixed_standard do %>
        <label class="form-control w-full max-w-xs grid gap-3" for="template_lipid_rate">
          <div class="label">
            <span class="label-text">Lipid Rate</span>
          </div>
          <input
            name="template_lipid_rate"
            type="number"
            step=".0001"
            class="input input-sm input-read-only"
            value="0.0"
            readonly
            x-bind:value="calculations.infusion.lipidRate.toFixed(2)"
          />
        </label>
      <% end %>
      <label class="form-control w-full max-w-xs grid gap-3" for="template_gir">
        <div class="label">
          <span class="label-text">GIR</span>
        </div>
        <input
          name="template_gir"
          type="number"
          step=".0001"
          class="input input-sm input-read-only"
          value="0.0"
          readonly
          x-bind:value="calculations.nutritional.gir.toFixed(2)"
        />
      </label>
      <label class="form-control w-full max-w-xs grid gap-3" for="template_amino_acid">
        <div class="label">
          <span class="label-text">Amino Acid %</span>
        </div>
        <input
          name="template_amino_acid"
          type="number"
          step=".0001"
          class="input input-sm input-read-only"
          value="0.0"
          readonly
          x-bind:value="calculations.nutritional.aminoAcidPercent.toFixed(2)"
        />
      </label>
      <label class="form-control w-full max-w-xs grid gap-3" for="template_dextrose">
        <div class="label">
          <span class="label-text">Dextrose %</span>
        </div>
        <input
          name="template_dextrose"
          type="number"
          step=".0001"
          class="input input-sm input-read-only"
          value="0.0"
          readonly
          x-bind:value="calculations.nutritional.dextrosePercent.toFixed(2)"
        />
      </label>
      <label class="form-control w-full max-w-xs grid gap-3" for="template_fat_infusion_rate">
        <div class="label">
          <span class="label-text">Fat Infusion Rate</span>
        </div>
        <input
          name="template_fat_infusion_rate"
          type="number"
          step=".0001"
          class="input input-sm input-read-only"
          value="0.0"
          readonly
          x-bind:value="calculations.nutritional.fatInfusionRate.toFixed(2)"
        />
      </label>
      <label class="form-control w-full max-w-xs grid gap-3" for="template_osmolarity">
        <div class="label">
          <span class="label-text">Osmolarity</span>
        </div>
        <input
          name="template_osmolarity"
          type="number"
          step=".0001"
          class="input input-sm input-read-only"
          value="0.0"
          readonly
          x-bind:value="calculations.nutritional.osmolarity.toFixed(2)"
        />
      </label>
    </div>
    <div class="mt-10 mb-4 px-4 flex items-center gap-4">
      <h2 class="font-semibold">Substances</h2>
      <button
        :if={@template.additional_substances_allowed}
        type="button"
        class="btn-sm-outline btn-xs"
        @click="addProduct"
      >
        Add More
      </button>
    </div>

    <div x-sort="handleSort">
      <template x-for="(product, index) in productsData">
        <div x-sort:item="product.id" class="flex p-4 space-x-4 border-t border-border">
          <div x-sort:handle class="cursor-move group">
            <.icon_move class="flex-shrink size-4 text-muted-foreground group-hover:text-foreground" />
          </div>
          <div class="flex-grow flex flex-col gap-4">
            <div>
              <span class="badge info" x-text="product.class_name"></span>
            </div>
            <div class="flex-grow grid grid-cols-6 gap-4">
              <label class="form-control w-full max-w-xs grid gap-3" for="template_dose">
                <div class="label">
                  <span class="label-text" x-text="`Dose (${product.dose_unit})`"></span>
                </div>
                <input
                  name="template_dose"
                  id="template_dose"
                  x-model="product.dose"
                  type="number"
                  step=".0001"
                  class="input input-sm input-bordered"
                  x-on:change="onDoseChange(product.id)"
                />
              </label>
              <label class="form-control w-full max-w-xs grid gap-3" for="template_product">
                <div class="label flex items-center gap-2">
                  <span class="label-text">Product</span>
                  <span
                    x-show="product.formulary_id"
                    class="label-text-alt cursor-pointer"
                    @click="openFormularyInfo(product.id)"
                  >
                    <.icon_eye class="size-4 text-muted-foreground hover:text-foreground cursor-pointer" />
                  </span>
                </div>
                <select
                  name="template_product"
                  id="template_product"
                  class="select w-full"
                  @change="handleProductChange($event, product.id)"
                >
                  <option value="">Select Product</option>
                  <template x-for="formulary in getClassFormularies(product.class_id)">
                    <option
                      x-bind:value="formulary.id"
                      x-bind:selected="formulary.id === product.formulary_id"
                    >
                      <span x-text="`${formulary.name}`"></span>
                    </option>
                  </template>
                </select>
              </label>
              <label class="form-control w-full max-w-xs grid gap-3" for="template_filling_method">
                <div class="label">
                  <span class="label-text">Filling Method</span>
                </div>
                <select
                  name="template_filling_method"
                  id="template_filling_method"
                  class="select w-full"
                  x-model="product.filling_method_id"
                >
                  <option value="">Select Filling Method</option>
                  <template x-for="methods in fillingMethods">
                    <option
                      x-bind:value="methods.id"
                      x-bind:selected="methods.id === product.filling_method_id"
                    >
                      <span x-text="`${methods.name}`"></span>
                    </option>
                  </template>
                </select>
              </label>
              <label class="form-control w-full max-w-xs grid gap-3" for="template_volume">
                <div class="label">
                  <span class="label-text">Volume</span>
                </div>
                <input
                  name="template_volume"
                  id="template_volume"
                  x-model="product.volume"
                  type="number"
                  step=".0001"
                  class="input input-sm input-read-only"
                  readonly
                />
              </label>
              <label class="form-control w-full max-w-xs grid gap-3" for="template_fill_volume">
                <div class="label">
                  <span class="label-text">Fill Volume</span>
                </div>
                <input
                  name="template_fill_volume"
                  id="template_fill_volume"
                  x-model="product.fill_volume"
                  type="number"
                  step=".0001"
                  class="input input-sm input-read-only"
                  readonly
                />
              </label>
              <label class="form-control w-full max-w-xs grid gap-3" for="template_osmolarity">
                <div class="label">
                  <span class="label-text">Osmolarity</span>
                </div>
                <input
                  name="template_osmolarity"
                  id="template_osmolarity"
                  x-bind:value="(product.osmolarity || 0).toFixed(2)"
                  type="text"
                  class="input input-sm input-read-only"
                  readonly
                  title="mOsm/L"
                />
              </label>
              <template x-if="product.additional_dose_allowed && preMixedStandard">
                <label
                  class="form-control w-full max-w-xs grid gap-3"
                  for="template_additional_dose"
                >
                  <div class="label">
                    <span class="label-text">
                      Additional Dose (<span x-text="product.additional_dose_unit"></span>)
                    </span>
                  </div>
                  <input
                    name="template_additional_dose"
                    id="template_additional_dose"
                    x-model="product.additional_dose"
                    type="number"
                    step=".0001"
                    class="input input-sm input-bordered"
                  />
                </label>
              </template>
              <template x-if="product.additional_dose_allowed && preMixedStandard">
                <label class="form-control w-full max-w-xs grid gap-3" for="template_max_allowed">
                  <div class="label">
                    <span class="label-text">
                      Max Allowed Limit (<span x-text="product.max_allowed_unit"></span>)
                    </span>
                  </div>
                  <input
                    name="template_max_allowed"
                    id="template_max_allowed"
                    x-model="product.max_allowed_limit"
                    type="number"
                    step=".0001"
                    class="input input-sm input-bordered"
                  />
                </label>
              </template>
            </div>
          </div>
          <div class="flex-shrink">
            <template x-if="!product.substance_locked_on_order">
              <button
                type="button"
                class="btn-sm-icon-outline btn-red"
                @click="removeProduct(product.id)"
              >
                <.icon_trash class="text-destructive" />
              </button>
            </template>
          </div>
        </div>
      </template>
    </div>
    <.order_template_product_info />
    <.add_substances />
    <.osmolarity_override_modal />
  </div>
<% end %>
