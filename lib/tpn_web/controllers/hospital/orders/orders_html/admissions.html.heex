<%= if Enum.empty?(@admissions) do %>
  <div class="p-10 w-full h-full flex items-center justify-center">
    <.no_records />
  </div>
<% else %>
  <div class="flex flex-col gap-4">
    <%= for admission <- @admissions do %>
      <div
        hx-get={"/patients/#{admission.patient_id}/orders/new/"}
        hx-target="#main-contents"
        hx-swap="innerHTML"
        hx-indicator="#main-contents-indicator"
        class="custom-card flex items-center justify-between gap-2 cursor-pointer"
      >
        <div class="text-xs text-foreground">
          <div>
            <span class="font-semibold">Name:</span>
            <span class="ml-2">{admission.first_name} {admission.last_name}</span>
          </div>
          <div class="flex items-center gap-2">
            <div>
              <span class="font-semibold">MRN:</span>
              <span class="ml-2">{admission.mrn}</span>
            </div>
            <div>
              <span class="font-semibold">Admission No:</span>
              <span class="ml-2">{admission.admission_no}</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div>
              <span class="font-semibold">Age:</span>
              <span class="ml-2">{admission.age}</span>
            </div>
            <div>
              <span class="font-semibold">Date:</span>
              <span class="ml-2">{admission.inserted_at}</span>
            </div>
          </div>
        </div>
        <.icon_angle_right />
      </div>
    <% end %>
  </div>
<% end %>
