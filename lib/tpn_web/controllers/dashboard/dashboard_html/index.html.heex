<div class="mx-auto max-w-7xl">
    <.header>
        Dashboard
    </.header>

    <div class="grid grid-cols-1 gap-4 px-4 lg:px-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

    <article class="group/item flex items-center border text-sm rounded-md transition-colors [a]:hover:bg-accent/50 [a]:transition-colors duration-100 flex-wrap outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] border-border p-4 gap-4">
      <div class="flex shrink-0 items-center justify-center gap-2 self-start [&_svg]:pointer-events-none size-8 border rounded-sm bg-muted [&_svg:not([class*='size-'])]:size-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path fill="currentColor" d="M26 30H6a2 2 0 0 1-2-2V16a2 2 0 0 1 2-2h3v2H6v12h20V16h-3v-2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2"/><path fill="currentColor" d="M13 20h6v2h-6zm7.59-11.41L17 12.17V2h-2v10.17l-3.59-3.58L10 10l6 6l6-6z"/></svg>
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <h3 class="flex w-fit items-center gap-2 text-sm leading-snug font-medium">1000 Orders</h3>
      </div>
      <button class="btn-sm-outline">New Order</button>
    </article>

    <article class="group/item flex items-center border text-sm rounded-md transition-colors [a]:hover:bg-accent/50 [a]:transition-colors duration-100 flex-wrap outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] border-border p-4 gap-4">
      <div class="flex shrink-0 items-center justify-center gap-2 self-start [&_svg]:pointer-events-none size-8 border rounded-sm bg-muted [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48"><g fill="currentColor"><path fill-rule="evenodd" d="M17 18c3.867 0 7-3.133 7-7s-3.133-7-7-7s-7 3.133-7 7s3.133 7 7 7m5-7c0 2.763-2.237 5-5 5s-5-2.237-5-5s2.237-5 5-5s5 2.237 5 5" clip-rule="evenodd"/><path d="M6 25.333c0-.472.258-.992.946-1.556s1.692-1.073 2.888-1.498C12.222 21.429 15.108 21 17 21s4.778.428 7.166 1.279q.504.18.959.377q.932-.71 1.982-1.247a14.5 14.5 0 0 0-2.27-1.014C22.227 19.465 19.113 19 17 19s-5.227.465-7.837 1.395c-1.304.464-2.548 1.067-3.485 1.836C4.74 22.999 4 24.03 4 25.333V31h16.153q.16-1.03.474-2H6z"/><path fill-rule="evenodd" d="M30 23a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2h-1v2.07a7 7 0 0 1 3.192 1.324L38.586 26l-.293-.293a1 1 0 0 1 1.414-1.414l2 2a1 1 0 0 1-1.414 1.414L40 27.414l-1.394 1.394A7 7 0 0 1 39.93 32H42v-1a1 1 0 1 1 2 0v4a1 1 0 1 1-2 0v-1h-2.07a7 7 0 0 1-.922 2.594L41 38.586l.293-.293a1 1 0 0 1 1.414 1.414l-2 2a1 1 0 0 1-1.414-1.414l.293-.293l-1.848-1.847A7 7 0 0 1 34 39.929V42h1a1 1 0 1 1 0 2h-4a1 1 0 1 1 0-2h1v-2.07a7 7 0 0 1-3.192-1.324L27.414 40l.293.293a1 1 0 0 1-1.414 1.414l-2-2a1 1 0 0 1 1.414-1.414l.293.293l1.394-1.394A7 7 0 0 1 26.07 34H24v1a1 1 0 1 1-2 0v-4a1 1 0 1 1 2 0v1h2.07a7 7 0 0 1 1.324-3.192L26 27.414l-.293.293a1 1 0 0 1-1.414-1.414l2-2a1 1 0 0 1 1.414 1.414l-.293.293l1.394 1.394A7 7 0 0 1 32 26.07V24h-1a1 1 0 0 1-1-1m-2 10a5 5 0 1 0 10 0a5 5 0 0 0-10 0" clip-rule="evenodd"/></g></svg>
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <h3 class="flex w-fit items-center gap-2 text-sm leading-snug font-medium">100 Patients</h3>
      </div>
      <button class="btn-sm-outline">Add Patient</button>
    </article>

    </div>
</div>
