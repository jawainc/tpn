<%!-- Mobile Menu --%> <.app_menu is_admin={@is_admin} user_access_level={@user_access_level} />
<div class="lg:pl-72">
  <.app_header name={@current_user.first_name} />
  <main class="py-10">
    <span class="loading loading-spinner loading-lg mx-auto mt10 main-contents-loader block htmx-indicator " />
    <div id="main-contents" class="px-4 sm:px-6 lg:px-8 main-contents hide-on-htmx-request">
      <div class="mx-auto max-w-7xl">
        <.header>
          Dashboard
        </.header>
      </div>

      <div class="mt-10 mx-auto max-w-7xl flex flex-col space-y-10">
        <div class="bg-gray-300/10 dark:bg-gray-700/10 px-10 flex flex-col w-full p-6 border border-white/5 rounded">
          <h2 class="font-semibold">
            Orders
          </h2>
        </div>

        <div class="bg-gray-300/10 dark:bg-gray-700/10 px-10 flex flex-col w-full p-6 border border-white/5 rounded">
          <h2 class="font-semibold">
            Admissions
          </h2>
        </div>

        <div class="bg-gray-300/10 dark:bg-gray-700/10 px-10 flex flex-col w-full p-6 border border-white/5 rounded">
          <h2 class="font-semibold">
            Patients
          </h2>
        </div>
      </div>
    </div>
  </main>
</div>
